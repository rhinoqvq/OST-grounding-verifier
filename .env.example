# Copy to .env and fill in. .env is gitignored.
OPENAI_API_KEY=
TYPESAFE_API_KEY=
DASHSCOPE_API_KEY=

# Optional overrides (defaults in src/verifier/harness/config.py)
# Which method POST /verify runs. Default: optimized (OST, OP29).
#   optimized   - OST, Jev only (TYPESAFE_API_KEY)
#   baseline    - no model calls
#   minimal_llm - one generative-model call per answer (OPENAI_API_KEY; GV_LLM_PROVIDER picks the provider)
#   minimal_jev - one Jev request per answer, the whole answer as one claim (TYPESAFE_API_KEY)
# The other values in config.py (minimal_jev_seg, _plus, _nc, _me) are ablation arms.
# GV_METHOD=optimized
# GV_LLM_PROVIDER=openai # openai | qwen
# GV_OPENAI_MODEL=gpt-6.1-sol
# GV_OPENAI_TEMPERATURE_ZERO=false  # true sends temperature=0 (models that accept it)
# GV_QWEN_MODEL=qwen-plus
# GV_QWEN_SCHEMA_MODE=json_schema  # json_object for models without schema support
# GV_JEV_MODEL=jev-1.13.0  # pinned; a served version other than GV_JEV_EXPECTED_SERVED (default jev-1.13.0) is logged as drift
# GV_CACHE_MODE=record   # off | record | replay
# GV_DB_PATH=var/verifier.sqlite3
